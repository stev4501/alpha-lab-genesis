#!/usr/bin/env python3
"""Start an interactive Claude Code session with the developer-only skills.

These skills are for humans working in this repository. The autonomous research
sessions started by `loop/run_session.sh` load no plugin directories and strip
skills outright, so nothing here affects them.

Two flags are passed:

    --plugin-dir <vendored plugin>          loads the skills
    --append-system-prompt-file <pointer>   tells them where their config lives

Both matter. Most of the skills expect an issue tracker and label vocabulary to
"have been provided" without naming a path, so the pointer is what stops them
asking for `/setup-matt-pocock-skills` to be re-run.

Selected print, background, and cloud flag forms are refused; see
`refusal_reason` and `docs/dev-only-skills.md` for the rules and the evidence
behind them. Everything else is forwarded verbatim.

Usage:
    bin/dev-session
    bin/dev-session /mattpocock-skills:tdd
    bin/dev-session --model sonnet
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

#: Long flags that put the session somewhere nobody is watching. Matched exactly
#: or with an `=value` suffix, so `--remote-control` is unaffected by `--remote`.
REFUSED_LONG = frozenset(
    {"--print", "--bg", "--background", "--cloud", "--remote"}
)

#: Plugin directories loaded for the session. Add one by dropping it in
#: dev/plugins/<name>/ with a .claude-plugin/plugin.json and listing it here.
PLUGIN_DIRS = ("dev/plugins/mattpocock-skills",)

#: Text appended to the system prompt, naming the files under docs/agents/.
#: Kept in a file so a direct `claude --plugin-dir ...` call can carry the same
#: pointer with one extra flag instead of retyping a paragraph.
CONFIG_PROMPT = "docs/agents/session-prompt.md"


def refusal_reason(arg: str) -> str | None:
    """Why `arg` is refused, or None if it is fine to forward.

    Three rules, in order — the order is what makes it correct:

    1. Exact long forms and their `=value` variants.
    2. Any other `--long` flag passes. This must come before rule 3, or
       `--permission-mode` is caught by its leading "p".
    3. A single-dash cluster containing "p". Claude Code accepts clustered short
       flags, so `-pd` and `-dp` engage `--print` exactly as `-p` does; an
       exact-match guard on `-p` misses every cluster.

    Note there is no `--` handling. Claude Code does not treat it as
    end-of-options for these flags — `claude -- --bg` starts a background
    session — so honouring it here would hand back the bypass this closes.
    """
    head = arg.split("=", 1)[0]
    if head in REFUSED_LONG:
        return f"{head} starts a print, background, or cloud session"
    if arg.startswith("--"):
        return None
    if arg.startswith("-") and "p" in arg:
        return f"{arg} is a short-flag cluster containing -p (print mode)"
    return None


def first_refusal(args: list[str]) -> tuple[str, str] | None:
    """The first refused argument and its reason, or None."""
    for arg in args:
        reason = refusal_reason(arg)
        if reason is not None:
            return arg, reason
    return None


def build_argv(
    claude_bin: str,
    repo_dir: Path,
    user_args: list[str],
    plugin_dirs: tuple[str, ...] = PLUGIN_DIRS,
    config_prompt: str = CONFIG_PROMPT,
) -> list[str]:
    """The full command line, with repository-relative paths made absolute."""
    argv = [claude_bin]
    for rel in plugin_dirs:
        argv += ["--plugin-dir", str(repo_dir / rel)]
    argv += ["--append-system-prompt-file", str(repo_dir / config_prompt)]
    return argv + user_args


def repo_root() -> Path:
    return Path(
        subprocess.run(
            ["git", "-C", str(Path(__file__).resolve().parent), "rev-parse", "--show-toplevel"],
            check=True, capture_output=True, text=True,
        ).stdout.strip()
    )


def check_paths(repo_dir: Path, plugin_dirs=PLUGIN_DIRS, config_prompt=CONFIG_PROMPT) -> list[str]:
    """Problems that would start a session missing its skills or its config."""
    problems = []
    for rel in plugin_dirs:
        if not (repo_dir / rel / ".claude-plugin" / "plugin.json").is_file():
            problems.append(f"not a plugin directory (no .claude-plugin/plugin.json): {rel}")
    if not (repo_dir / config_prompt).is_file():
        problems.append(f"missing {config_prompt} — skills would start unconfigured")
    return problems


def main(user_args: list[str]) -> int:
    repo_dir = repo_root()

    refused = first_refusal(user_args)
    if refused is not None:
        arg, reason = refused
        print(f"dev-session: refusing {arg} — {reason}.", file=sys.stderr)
        print("  These plugins are scoped to interactive developer sessions.", file=sys.stderr)
        print("  To opt out deliberately, call claude directly — include the", file=sys.stderr)
        print("  config pointer, or the skills start unconfigured:", file=sys.stderr)
        print(f"    claude --plugin-dir {PLUGIN_DIRS[0]} \\", file=sys.stderr)
        print(f"           --append-system-prompt-file {CONFIG_PROMPT} {arg} ...", file=sys.stderr)
        return 2

    problems = check_paths(repo_dir)
    if problems:
        for problem in problems:
            print(f"dev-session: {problem}", file=sys.stderr)
        return 1

    claude_bin = os.environ.get("CLAUDE_BIN", "claude")
    argv = build_argv(claude_bin, repo_dir, user_args)
    os.chdir(repo_dir)
    os.execvp(argv[0], argv)  # replaces this process; never returns


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
