#!/usr/bin/env bash
# dev-session — start an interactive Claude Code session with the developer-only
# skill plugins loaded.
#
# These skills are for humans doing development work in this repository. They are
# deliberately unavailable to the autonomous research sessions started by
# loop/run_session.sh, which loads no plugin directories at all.
#
# Usage:
#   bin/dev-session                 # interactive session
#   bin/dev-session /mattpocock-skills:tdd
#
# Non-interactive mode is refused: see the -p check below. Other claude flags
# are forwarded verbatim.
#
# See docs/dev-only-skills.md for why this is a flag and not a settings entry.

set -euo pipefail

REPO_DIR="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

# Every directory listed here is loaded as a plugin for this session only.
# Add a plugin by dropping it in dev/plugins/<name>/ with a
# .claude-plugin/plugin.json and adding the path below.
PLUGIN_DIRS=(
  "$REPO_DIR/dev/plugins/mattpocock-skills"
)

# Refuse non-interactive mode. These skills are for a human at a keyboard; the
# whole arrangement exists to keep them away from unattended agents. Nothing
# stops a future script from reaching for this wrapper to get skills into a
# headless run, so the wrapper refuses rather than relying on nobody trying.
# A developer who genuinely wants headless-with-skills can invoke claude
# directly with --plugin-dir and own that decision explicitly.
for arg in "$@"; do
  case "$arg" in
    -p|--print)
      echo "dev-session: refusing non-interactive mode ($arg)." >&2
      echo "  These plugins are scoped to interactive developer sessions." >&2
      echo "  To opt out deliberately, call claude directly:" >&2
      echo "    claude --plugin-dir dev/plugins/mattpocock-skills $arg ..." >&2
      exit 2
      ;;
  esac
done

PLUGIN_ARGS=()
for dir in "${PLUGIN_DIRS[@]}"; do
  if [[ ! -f "$dir/.claude-plugin/plugin.json" ]]; then
    echo "dev-session: not a plugin directory (no .claude-plugin/plugin.json): $dir" >&2
    exit 1
  fi
  PLUGIN_ARGS+=(--plugin-dir "$dir")
done

cd "$REPO_DIR"
exec "$CLAUDE_BIN" "${PLUGIN_ARGS[@]}" "$@"
