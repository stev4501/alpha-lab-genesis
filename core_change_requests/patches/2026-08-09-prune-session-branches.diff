+name: prune-session-branches
+
+# Manual trigger only for now. The schedule below is intentionally commented
+# out, exactly as session.yml was: a human enables it after workflow_dispatch
+# runs prove the rules select the branches they are meant to and nothing else.
+#
+# The dispatch input defaults to a dry run. On the schedule event `inputs` is
+# empty, so the guarded expression below evaluates to false and a scheduled run
+# deletes for real — deliberate, and the reason to leave the schedule off until
+# a dry run has been read.
+on:
+  workflow_dispatch:
+    inputs:
+      dry_run:
+        description: "List what would be deleted without deleting it"
+        type: boolean
+        default: true
+# on:
+#   schedule:
+#     - cron: "17 4 * * 0"      # Sundays 04:17 UTC, well clear of any session
+
+concurrency:
+  group: prune-session-branches   # NOT the research-session group: pruning must
+  cancel-in-progress: false       # never queue behind a 110-minute session
+
+permissions:
+  contents: write                 # required for `git push origin --delete`
+
+jobs:
+  prune:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          # fetch-depth: 0 is required: the script counts each failed/<id>
+          # branch's commits against main and reads journals/<id>.md out of
+          # origin/main, neither of which a shallow clone can answer.
+
+      - name: Prune failed session branches
+        env:
+          DRY_RUN: ${{ inputs.dry_run == true }}
+          EMPTY_RETENTION_DAYS: "7"
+          WORK_RETENTION_DAYS: "90"
+        run: bash loop/prune_branches.sh
